# Server-only path; relative paths resolve from server/, regardless of process cwd.
# Export this environment variable before starting the server (.env is not auto-loaded).
DATABASE_PATH=data/guild.sqlite
PORT=2567

# Comma-separated browser origins permitted to create guests. Use HTTPS origins in production.
GUEST_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fail closed: debug gold and legacy imports require NODE_ENV=development.
NODE_ENV=production
# Additionally opt in only on an authorized local/development server.
ENABLE_LEGACY_IMPORT=false
